{
  "manifest_version": 3,
  "name": "F&M Adaptive Course Planner",
  "version": "1.4.0",
  "description": "Plan courses, sync Spring 2027 availability, and import Degree Works requirements.",
  "action": {
    "default_title": "F&M Course Planner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webapps.fandm.edu/courseschedule",
        "https://webapps.fandm.edu/courseschedule/*"
      ],
      "js": [
        "redirect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:3000/*"
      ],
      "js": [
        "planner-bridge.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://prd-reg9.fandm.edu/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
