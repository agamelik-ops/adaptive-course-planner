{
  "manifest_version": 3,
  "name": "F&M Adaptive Course Planner",
  "version": "1.0.0",
  "description": "Redirect the F&M course schedule to our planner.",
  "action": {
    "default_title": "Open Course Planner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webapps.fandm.edu/courseschedule",
        "https://webapps.fandm.edu/courseschedule/*"
      ],
      "js": ["redirect.js"],
      "run_at": "document_start"
    }
  ]
}