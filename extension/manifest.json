{
  "manifest_version": 3,
  "name": "F&M Adaptive Course Planner",
  "version": "1.1.0",
  "description": "Open our updated planner and import Degree Works requirements.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Import requirements or open planner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webapps.fandm.edu/courseschedule",
        "https://webapps.fandm.edu/courseschedule/*"
      ],
      "js": ["redirect.js"],
      "run_at": "document_start"
    }
  ]
}