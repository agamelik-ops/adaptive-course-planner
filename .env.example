# Copy this file to .env.local and fill in your key. Never commit .env.local.
#
# The planning assistant works with any OpenAI-compatible chat API that supports tool calling.
# Default: Groq's free tier. Create a key at https://console.groq.com/keys
AI_API_KEY=

# Optional overrides (defaults shown):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# (Groq's model list changes; any current model that supports tool calling works.)
#
# Local, private alternative (Ollama): install Ollama, run `ollama pull qwen2.5`, then use
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5
# AI_API_KEY=ollama
